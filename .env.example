# Database Connection (PostgreSQL)
DB_NAME=kostku_db
DB_USER=postgres
DB_PASSWORD=replace_with_a_unique_random_password
DATABASE_URL="postgresql://postgres:replace_with_a_unique_random_password@localhost:5432/kostku_db?schema=public"

# App URL & Ports
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production Server port mapping (agar tidak bentrok dengan Web-L port 3000)
HOST_PORT=3001

