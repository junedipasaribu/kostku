# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/kostku_db?schema=public"

# App URL & Ports
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production Server port mapping (agar tidak bentrok dengan Web-L port 3000)
HOST_PORT=3001

# Auth Secret
NEXTAUTH_SECRET="kostku_secret_super_secure_key_change_in_production"
NEXTAUTH_URL="http://localhost:3000"
